// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  type      String   @default("F")

  name      String

  client    String
  manager   String

  salesStaff  String?   // 営業担当者
  clientStaff String?   // 発注者担当者

  outsourceCompany String? // 外注依頼先
  outsourceCost    Int?    // 外注費

  amount    Int
  budget    Int?      // 実行予算

  additionalAmount Int? // 追加受注金額

  materialCost     Int? // 材料費
  laborCost        Int? // 労務費
  expenseCost      Int? // 経費他

  status    String

  note      String?   // 備考

  orderDate DateTime? //受注日

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Counter {
  name  String @id  // 例: F-2026, E-2026
  value Int
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Staff {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model ProjectType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
}

model FiscalYear {
  id        Int      @id @default(autoincrement())
  year      Int      @unique
  endMonth  Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}